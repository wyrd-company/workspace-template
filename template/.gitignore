# Clones and worktrees created inside the container; each is its own repository.
/repos/
/tasks/
/workflows/

# Compose projects of a docker-outside-of-docker workspace.
/docker/

# Agent and service state. Each folder's own .gitignore keeps its contents out;
# anything else directly under state/ is ignored, so a new folder stays out too.
/state/*
!/state/claude/
!/state/codex/
!/state/pi/
!/state/t3/
!/state/workflows/
